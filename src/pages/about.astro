---
import PageLayout from "@/layouts/Base";

const meta = {
	title: "About",
	description: "Member of Technical Staff at Taste Labs.",
};
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<h1 class="title">About</h1>
		<p>
			Member of Technical Staff at <a
				class="cactus-link inline-block"
				href="https://www.tastelabs.com/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="github repository">Taste Labs</a
			>.
		</p>
		<p class="mb-4 text-xl font-semibold">Experience</p>
		<div class="space-y-6">
			{
				[
					{
						startDate: "Jun 2026",
						endDate: "Present",
						role: "Member of Technical Staff",
						company: "Taste Labs",
						description: "5th engineer. Working on agentic products.",
					},
					{
						startDate: "Jul 2025",
						endDate: "Jun 2026",
						role: "Artificial Intelligence Engineer",
						company: "Tiendanube",
						description: "Building AI agents for more than 180,000 merchants in all Latin America.",
					},
					{
						startDate: "Mar 2024",
						endDate: "May 2026",
						role: "Co-founder",
						company: "Roomix",
						description:
							'Empty rooms were killing sales, not anymore. <a href="https://roomix.ai/" target="_blank" rel="noopener noreferrer" class="cactus-link inline-block">roomix.ai</a>',
					},
					{
						startDate: "Aug 2023",
						endDate: "Jul 2025",
						role: "Software Engineer",
						company: "Lemon Cash",
						description:
							"Developed internal tools for the engineering team. Automated processes leveraging generative AI.",
					},
					{
						startDate: "Jul 2023",
						endDate: "Nov 2024",
						role: "Research Assistant",
						company: "University of Palermo",
						description:
							"I was part of a research team focused on detecting cyber attacks —such as DDoS, DoS, and brute force attacks— using traditional machine learning techniques.",
					},
					{
						startDate: "Aug 2022",
						endDate: "Jun 2023",
						role: "Data Analyst",
						company: "KUDO",
						description:
							"I was responsible for developing several Tableau dashboards for various internal teams. I was also in charge of developing, maintaining, and deploying machine learning systems for the data science team.",
					},
				].map((experience) => (
					<div class="flex flex-col gap-2">
						<div class="flex flex-col gap-2">
							<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
								<span class="font-medium">
									{experience.role} · <span class="text-accent">{experience.company}</span>
								</span>
								<span class="text-sm text-gray-500 dark:text-gray-400">
									{experience.startDate} - {experience.endDate}
								</span>
							</div>
							<p
								class="text-xs text-gray-600 dark:text-gray-400"
								set:html={experience.description}
							/>
						</div>
					</div>
				))
			}
		</div>
		<p class="mb-4 text-xl font-semibold">Education</p>
		<div class="space-y-6">
			{
				[
					{
						startDate: "Mar 2020",
						endDate: "Dec 2025",
						degree: "BSc in Artificial Intelligence",
						institution: "University of Palermo",
						description: "Cum Laude",
					},
				].map((education) => (
					<div class="flex flex-col gap-2">
						<div class="flex flex-col gap-2">
							<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between">
								<span class="font-medium">
									{education.degree} · <span class="text-accent">{education.institution}</span>
								</span>
								<span class="text-sm text-gray-500 dark:text-gray-400">
									{education.startDate} - {education.endDate}
								</span>
							</div>
							<p class="text-xs text-gray-600 dark:text-gray-400">{education.description}</p>
						</div>
					</div>
				))
			}
		</div>
		<div class="mt-12">
			<p>
				Find me on <a
					class="cactus-link inline-block"
					href="https://www.linkedin.com/in/tadeo-donegana-braunschweig/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="github repository">LinkedIn</a
				> or download my <a
					class="cactus-link inline-block"
					href="https://www.linkedin.com/in/tadeo-donegana-braunschweig/"
					target="_blank"
					rel="noopener noreferrer"
					aria-label="github repository">Curriculum Vitae</a
				> to learn more about my experience.
			</p>
		</div>
	</div>
</PageLayout>
