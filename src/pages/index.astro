---
import PageLayout from "@/layouts/Base";
import PostPreview from "@/components/blog/PostPreview";
import SocialList from "@/components/SocialList";
import { getAllPosts, sortMDByDate } from "@/utils";

const MAX_POSTS = 10;
const MAX_PINNED_POSTS = 3;
const allPosts = await getAllPosts();
const sortedPosts = sortMDByDate(allPosts);
const allPostsByDate = sortedPosts.slice(0, MAX_POSTS);
const pinnedPosts = sortedPosts.filter((p) => p.data.pinned).slice(0, MAX_PINNED_POSTS);

// Commented out until Projects section is implemented
/* const cactusTech: Array<{ title: string; desc: string; href: string }> = [
	{
		title: "vid2densepose",
		desc: "Convert your videos to densepose and use it on MagicAnimate.",
		href: "https://github.com/Flode-Labs/vid2densepose",
	},
	// ... other projects
]; */
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<p class="mb-6">
			AI Engineer. Member of Technical Staff at <a
				class="cactus-link inline-block"
				href="https://www.tastelabs.com/"
				target="_blank"
				rel="noopener noreferrer"
				aria-label="Taste Labs">Taste Labs</a
			>.
		</p>
		<SocialList />
	</section>
	{
		pinnedPosts.length > 0 && (
			<section class="mt-16">
				<h2 class="title mb-6 text-xl">Pinned Posts</h2>
				<ul class="space-y-4" role="list">
					{pinnedPosts.map((p) => (
						<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
							<PostPreview post={p} />
						</li>
					))}
				</ul>
			</section>
		)
	}
	<section aria-label="Blog post list" class="mt-16">
		<h2 class="title mb-4 text-xl">Posts</h2>
		<ul class="space-y-6">
			{
				allPostsByDate.map((p) => (
					<li>
						<PostPreview post={p} withDesc={true} />
					</li>
				))
			}
		</ul>
	</section>
	<!-- Projects section TBD -->
	<!--
	<section class="mt-8">
		<h2 class="title mb-4 text-xl">Projects</h2>
		<ul class="space-y-4 sm:space-y-2">
			{
				cactusTech.map(({ href, title, desc }) => (
					<li>
						<>
							<>
								<a
									href={href}
									target="_blank"
									rel="noopener noreferrer"
									class="cactus-link inline-block"
								>
									{title}
								</a>
								:<p class="inline-block sm:mt-2">{desc}</p>
							</>
						</>
					</li>
				))
			}
		</ul>
	</section>
	-->
</PageLayout>
