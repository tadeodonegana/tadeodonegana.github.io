---
import type { CollectionEntry } from "astro:content";
import type { HTMLTag, Polymorphic } from "astro/types";
import FormattedDate from "../FormattedDate.astro";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }> & {
	post: CollectionEntry<"post">;
	withDesc?: boolean;
};

const { post, as: Tag = "div", withDesc = false } = Astro.props;
const postDate = post.data.updatedDate ?? post.data.publishDate;
const postUrl = `/posts/${post.slug}/`;
---

<div class="flex min-w-0 flex-col">
	<div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
		<FormattedDate date={postDate} class="text-gray-600 dark:text-gray-400" />
		<Tag>
			{post.data.draft && <span class="text-red-500">(Draft) </span>}
			<a href={postUrl} class="cactus-link font-bold" data-astro-prefetch>
				{post.data.title}
			</a>
		</Tag>
	</div>
	{withDesc && <q class="mt-2 line-clamp-3 block italic">{post.data.description}</q>}
</div>
