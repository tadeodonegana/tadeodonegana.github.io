---
import { menuLinks, siteConfig } from "@/site-config";

interface Props {
	// On xl screens, match the post layout's xl:-mx-32 breakout.
	wide?: boolean;
}

const { wide = false } = Astro.props;
const year = new Date().getFullYear();
// There is no English Wikipedia article for the town, so link the Spanish one.
const landscapeHref = "https://es.wikipedia.org/wiki/Sierras_Bayas";
const landscapeLabel =
	"Pixel-art view of Sierras Bayas: low flat-topped hills with antennas, a small cement plant, tiny houses among trees, and the quarry lake. Read about Sierras Bayas on Wikipedia (opens in a new tab).";
---

<footer class="mt-auto w-full pt-20">
	{
		/* The links and copyright sit in the sky of the landscape, centred over it,
		   with the copyright under the links (after rileyadkisson.com's footer).
		   Below sm the sky is too short, so they stack above the art instead.

		   The art sits in the content column like the post list, and its side
		   edges fade into the page. Pixel art in greys from the site palette, one
		   file per theme and width, generated by scripts/footer-landscape.mjs and
		   shown at 2x without smoothing. The theme is a class on <html>, so swap
		   with dark: rather than <picture media>. Post pages are 960px wide on xl
		   screens, so they swap to the wide files there. */
	}
	<div
		class:list={["footer-scene relative flex flex-col items-center", wide && "xl:-mx-32"]}
		data-footer-scene
	>
		<a
			href={landscapeHref}
			target="_blank"
			rel="noopener noreferrer"
			aria-label={landscapeLabel}
			title="Sierras Bayas, on Wikipedia"
			class="footer-art relative order-3 mt-0 block w-full focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-textColor sm:order-none"
			data-footer-art
			data-wide={wide ? "true" : "false"}
		>
			<img
				src="/footer/sierras-bayas-light.png"
				alt=""
				width="704"
				height="232"
				class:list={[
					"block h-auto w-full [image-rendering:pixelated] dark:hidden",
					wide && "xl:hidden",
				]}
				loading="lazy"
				decoding="async"
			/>
			<img
				src="/footer/sierras-bayas-dark.png"
				alt=""
				aria-hidden="true"
				width="704"
				height="232"
				class:list={[
					"hidden h-auto w-full [image-rendering:pixelated] dark:block",
					wide && "dark:xl:hidden",
				]}
				loading="lazy"
				decoding="async"
			/>
			{
				wide && (
					<>
						<img
							src="/footer/sierras-bayas-light-wide.png"
							alt=""
							aria-hidden="true"
							width="960"
							height="232"
							class="hidden h-auto w-full [image-rendering:pixelated] xl:block dark:xl:hidden"
							loading="lazy"
							decoding="async"
						/>
						<img
							src="/footer/sierras-bayas-dark-wide.png"
							alt=""
							aria-hidden="true"
							width="960"
							height="232"
							class="hidden h-auto w-full [image-rendering:pixelated] dark:xl:block"
							loading="lazy"
							decoding="async"
						/>
					</>
				)
			}
			{/* Animated layer on the same pixel grid; see src/utils/footerAnimation.ts. */}
			<canvas
				class="pointer-events-none absolute inset-0 h-full w-full [image-rendering:pixelated]"
				aria-hidden="true"></canvas>
		</a>
		<nav
			aria-label="More on this site"
			class="order-1 flex justify-center gap-x-2 font-semibold text-gray-600 dark:text-gray-400 sm:pointer-events-none sm:absolute sm:inset-x-0 sm:top-5 sm:gap-x-0 sm:text-xs"
		>
			<div class="flex sm:divide-x sm:divide-gray-500">
				{
					menuLinks.map((link) => (
						<a
							href={link.path}
							class="px-4 py-2 tracking-wide transition-colors duration-150 sm:pointer-events-auto sm:px-2 sm:py-0 sm:hover:text-textColor sm:hover:underline"
						>
							{link.title}
						</a>
					))
				}
			</div>
		</nav>
		<p
			class="pointer-events-none order-2 mt-2 text-center font-semibold tracking-[.04em] text-gray-600 dark:text-gray-400 sm:absolute sm:inset-x-0 sm:top-16 sm:mt-0 sm:text-xs"
		>
			Copyright &copy; {year}{" "}
			{siteConfig.author}
		</p>
	</div>
</footer>

<script>
	import { initFooterAnimation } from "../../utils/footerAnimation";

	document.querySelectorAll<HTMLElement>("[data-footer-art]").forEach(initFooterAnimation);
</script>

<style>
	/* Entrance, after bygideon.com's home reveal: each part fades in and rises
	   half a rem over 0.76s, 90ms after the one before (art, links, copyright).
	   The script sets data-reveal on first sight, so without JavaScript
	   everything simply shows. fill-mode both leaves no residual transform. */
	.footer-scene[data-reveal="pending"] > * {
		opacity: 0;
		transform: translateY(0.5rem);
	}
	.footer-scene[data-reveal="shown"] > * {
		animation: 0.76s both footer-reveal;
	}
	.footer-scene[data-reveal="shown"] > :nth-child(2) {
		animation-delay: 90ms;
	}
	.footer-scene[data-reveal="shown"] > :nth-child(3) {
		animation-delay: 0.18s;
	}
	@keyframes footer-reveal {
		0% {
			opacity: 0;
			transform: translateY(0.5rem);
		}
		to {
			opacity: 1;
			transform: translate(0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.footer-scene[data-reveal] > * {
			opacity: 1;
			animation: none;
			transform: none;
		}
	}
</style>
