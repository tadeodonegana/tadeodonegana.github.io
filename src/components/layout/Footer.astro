---
import { menuLinks, siteConfig } from "@/site-config";

interface Props {
	// On xl screens, match the post layout's xl:-mx-32 breakout.
	wide?: boolean;
}

const { wide = false } = Astro.props;
const year = new Date().getFullYear();
// There is no English Wikipedia article for the town, so link the Spanish one.
const landscapeHref = "https://es.wikipedia.org/wiki/Sierras_Bayas";
const landscapeLabel =
	"Pixel-art view of Sierras Bayas: low flat-topped hills with antennas, a small cement plant, tiny houses among trees, and the quarry lake. Read about Sierras Bayas on Wikipedia (opens in a new tab).";
---

<footer class="mt-auto w-full pt-20">
	<div
		class="flex flex-col items-center justify-center gap-y-2 text-center align-top font-semibold text-gray-600 dark:text-gray-400 sm:flex-row sm:justify-between sm:text-xs"
	>
		<div class="me-0 sm:me-4">
			Copyright &copy; {year}{" "}
			{siteConfig.author}
		</div>
		<nav
			aria-label="More on this site"
			class="flex gap-x-2 sm:gap-x-0 sm:divide-x sm:divide-gray-500"
		>
			{
				menuLinks.map((link) => (
					<a
						href={link.path}
						class="px-4 py-2 sm:px-2 sm:py-0 sm:hover:text-textColor sm:hover:underline"
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
	{
		/* Sits in the content column like the post list, and its side edges fade
		   into the page. Pixel art in greys from the site palette, one file per
		   theme and width, generated by scripts/footer-landscape.mjs and shown at
		   2x without smoothing. The theme is a class on <html>, so swap with dark:
		   rather than <picture media>. Post pages are 960px wide on xl screens,
		   so they swap to the wide files there. */
	}
	<a
		href={landscapeHref}
		target="_blank"
		rel="noopener noreferrer"
		aria-label={landscapeLabel}
		title="Sierras Bayas, on Wikipedia"
		class:list={[
			"footer-art relative mt-6 block focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-textColor",
			wide && "xl:-mx-32",
		]}
		data-footer-art
		data-wide={wide ? "true" : "false"}
	>
		<img
			src="/footer/sierras-bayas-light.png"
			alt=""
			width="704"
			height="200"
			class:list={[
				"block h-auto w-full [image-rendering:pixelated] dark:hidden",
				wide && "xl:hidden",
			]}
			loading="lazy"
			decoding="async"
		/>
		<img
			src="/footer/sierras-bayas-dark.png"
			alt=""
			aria-hidden="true"
			width="704"
			height="200"
			class:list={[
				"hidden h-auto w-full [image-rendering:pixelated] dark:block",
				wide && "dark:xl:hidden",
			]}
			loading="lazy"
			decoding="async"
		/>
		{
			wide && (
				<>
					<img
						src="/footer/sierras-bayas-light-wide.png"
						alt=""
						aria-hidden="true"
						width="960"
						height="200"
						class="hidden h-auto w-full [image-rendering:pixelated] xl:block dark:xl:hidden"
						loading="lazy"
						decoding="async"
					/>
					<img
						src="/footer/sierras-bayas-dark-wide.png"
						alt=""
						aria-hidden="true"
						width="960"
						height="200"
						class="hidden h-auto w-full [image-rendering:pixelated] dark:xl:block"
						loading="lazy"
						decoding="async"
					/>
				</>
			)
		}
		{/* Animated layer on the same pixel grid; see src/utils/footerAnimation.ts. */}
		<canvas
			class="pointer-events-none absolute inset-0 h-full w-full [image-rendering:pixelated]"
			aria-hidden="true"></canvas>
	</a>
</footer>

<script>
	import { initFooterAnimation } from "../../utils/footerAnimation";

	document.querySelectorAll<HTMLElement>("[data-footer-art]").forEach(initFooterAnimation);
</script>

<style>
	/* A slow, soft rise the first time the art scrolls into view. The script
	   sets data-reveal, so without JavaScript the art simply shows. */
	.footer-art[data-reveal] {
		transition:
			opacity 1.4s cubic-bezier(0.2, 0.7, 0.2, 1),
			transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1),
			filter 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}
	.footer-art[data-reveal="pending"] {
		opacity: 0;
		transform: translateY(8px);
		filter: blur(2px);
	}
	@media (prefers-reduced-motion: reduce) {
		.footer-art[data-reveal] {
			transition: opacity 0.6s ease;
			transform: none;
			filter: none;
		}
	}
</style>
